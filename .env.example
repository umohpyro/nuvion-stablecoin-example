# Required in production: a long random string that seals each visitor's cookie. Local development generates one for you.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. The app refuses any host that is not *.nuvion.dev, so it can never reach production.
# NUVION_API_URL=https://api.nuvion.dev

# Optional. Set to true to allow sends only to recipients saved on the Recipients page.
# SEND_ONLY_TO_SAVED=true
