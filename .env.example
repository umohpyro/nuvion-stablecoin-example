# Sandbox API key from https://app.nuvion.dev/dashboard/settings
NUVION_API_KEY=

# The approved entity that owns the treasury. Open /setup after the first deploy: it lists the IDs to copy.
NUVION_ENTITY_ID=

# Optional. The signing secret returned when you register a webhook.
NUVION_WEBHOOK_SECRET=

# Optional. The app refuses any host that is not *.nuvion.dev, so it can never reach production.
# NUVION_API_URL=https://api.nuvion.dev

# Optional. When set, every page asks for this password (HTTP Basic, any username). Set it on any public deployment.
# DEMO_PASSWORD=
